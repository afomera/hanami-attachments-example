# This is checked into source control, so put sensitive values into `.env.local`.
#
# See https://hanakai.org/learn/hanami/app/settings for how `.env` files are loaded.

DATABASE_URL=sqlite://db/shoebox.sqlite

# SMTP delivery for Hanami Mailer (in development and production envs only).
#
# See https://hanakai.org/learn/hanami/mailers for details.
#
# Set these in `.env.local` or another `.env` file not checked into source control.
#
# SMTP_ADDRESS=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=mailer@example.com
# SMTP_PASSWORD=s3cr3t
# SMTP_AUTHENTICATION=plain

# File storage for attachments (hanami-attachments). Development stores files in storage/ and tests
# keep them in memory. For S3 or an S3-compatible service, set these in `.env.local` or your host's
# environment (not in this file, which is checked in):
#
# STORAGE_SERVICE=s3
# STORAGE_BUCKET=my-app-uploads
# STORAGE_REGION=us-east-1
# STORAGE_ACCESS_KEY_ID=
# STORAGE_SECRET_ACCESS_KEY=
#
# Cloudflare R2: STORAGE_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com and STORAGE_REGION=auto
# MinIO:         STORAGE_ENDPOINT=http://localhost:9000
#
# STORAGE_PUBLIC=false  # true: public-read objects with plain URLs. false: short-lived signed URLs.
# STORAGE_CDN_HOST=     # e.g. https://cdn.example.com, for public files

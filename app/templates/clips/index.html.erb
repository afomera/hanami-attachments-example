<h1>Clips</h1>

<%= form_for routes.path(:clips), class: "upload-form" do |f| %>
  <p>
    <label for="clip-video">Video (MP4, WebM or MOV, up to 2 GB)</label>
    <%= attachment_field f, "clip.video", attachment: video, uploader: Shoebox::Uploaders::VideoUploader, id: "clip-video" %>
    <progress data-upload-progress max="100" value="0" hidden></progress>
    <small data-upload-status role="status"></small>
  </p>
  <p>
    <label for="clip-title">Title</label>
    <%= f.text_field "clip.title", id: "clip-title", maxlength: 200, placeholder: "Defaults to the file name" %>
  </p>
  <p><%= f.submit "Add clip" %></p>
<% end %>

<% if clips.empty? %>
  <p class="empty">No clips yet.</p>
<% else %>
  <ul class="clips">
    <% clips.each do |clip| %>
      <li><a href="<%= routes.path(:clip, id: clip.id) %>"><%= clip.title %></a>
        <small><%= Hanami::Attachments.format_size(clip.video.size) %></small></li>
    <% end %>
  </ul>
<% end %>

